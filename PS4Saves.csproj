<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>PS4Saves</RootNamespace>
        <AssemblyName>PS5 Save Mounter Batch</AssemblyName>
        <Product>PS5 Save Mounter Batch</Product>
        <Title>PS5 Save Mounter Batch</Title>
        <Description>Batch save backups based on PlayStation 5 Save Mounter.</Description>
        <Version>0.1.0-dev.5</Version>
        <FileVersion>0.1.0.5</FileVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
        <FileAlignment>512</FileAlignment>
        <Deterministic>true</Deterministic>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="tests\**\*.cs" />
        <Compile Remove="Main.cs;Main.Designer.cs" />
        <EmbeddedResource Remove="Main.resx" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    </ItemGroup>
</Project>
