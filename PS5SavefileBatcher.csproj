<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <RootNamespace>PS5SavefileBatcher</RootNamespace>
        <AssemblyName>PS5 Savefile Batcher</AssemblyName>
        <Product>PS5 Savefile Batcher</Product>
        <Title>PS5 Savefile Batcher</Title>
        <Description>Batch save backups based on PlayStation 5 Save Mounter.</Description>
        <Version>1.1</Version>
        <FileVersion>1.1.0.0</FileVersion>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
        <FileAlignment>512</FileAlignment>
        <Deterministic>true</Deterministic>
        <!-- Keep the full Windows Forms runtime, compressed inside portable builds. -->
        <EnableCompressionInSingleFile Condition="'$(PublishSingleFile)' == 'true'">true</EnableCompressionInSingleFile>
        <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <Compile Remove="tests\**\*.cs" />
        <Compile Remove="linux\**\*.cs" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    </ItemGroup>
</Project>
